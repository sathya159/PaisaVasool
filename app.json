{
  "expo": {
    "name": "paisavasool",
    "slug": "paisavasool",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paisavasool.personal",
      "config": {
        "usesNonExemptEncryption": true
      }
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-document-picker"
    ],
    "web": {
      "bundler": "metro"
    }
  }
}

